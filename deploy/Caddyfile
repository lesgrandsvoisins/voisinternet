lesgrandsvoisins.com, www.lesgrandsvoisins.com {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/voisinternet/staticfiles
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle_path /media/* {
		root * /srv/voisinternet/var/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://auth.example.org"
		Permissions-Policy "interest-cohort=(), camera=(), microphone=(), geolocation=()"
	}
}

# Anciens domaines : redirection permanente en gardant le chemin.
voisinter.net, www.voisinter.net, voisinternet.fr, voisinternet.com, voisinternet.org {
	redir https://lesgrandsvoisins.com{uri} permanent
}
