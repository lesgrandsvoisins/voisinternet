# Instance d'ESSAI de voisinternet (essai.resdigita.org), sur rosest330 : second gunicorn, autre port, base PostgreSQL VIDE.
# Format systemd (CLE=valeur, sans guillemets utiles, sans interprétation du « $ »). Aucun secret dans ce fichier du dépôt.
DJANGO_DEBUG=false
# À REMPLIR : une clé et un pepper NOUVEAUX et DIFFÉRENTS de la production (python3 -c "import secrets;print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=
VOISINTERNET_ANON_PEPPER=
DJANGO_ALLOWED_HOSTS=essai.resdigita.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://essai.resdigita.org
DJANGO_IP=127.0.0.1
DJANGO_PORT=8092
VOISINTERNET_BEHIND_PROXY=true
# Dossiers PROPRES à l'essai (jamais ceux de la production).
DJANGO_STATIC_ROOT=/var/voisinter-essai/staticfiles
DJANGO_MEDIA_ROOT=/var/voisinter-essai/media
DJANGO_CACHE_DIR=/var/voisinter-essai/cache
# Base PostgreSQL vide, propre à l'essai.
POSTGRES_DB=voisinter-essai
POSTGRES_USER=voisinter-essai
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Aucun courrier réel, aucune écriture dans l'annuaire.
EMAIL_HOST=
VOISINTERNET_REDIRECTIONS=non
VOISINTERNET_CONTACT_FORMS=false
# Le clone de Keycloak. Client `voisinternet` : secret identique à key.gv.je (à copier à la main, jamais ici).
KEYCLOAK_REALM_URL=https://key.resdigita.org/realms/master
OIDC_RP_CLIENT_ID=voisinternet
OIDC_RP_CLIENT_SECRET=
VOISINTERNET_BLOG_URL=https://blog.lesgrandsvoisins.com
VOISINTERNET_GUIDE_URL=https://wiki.grandsvoisins.org
