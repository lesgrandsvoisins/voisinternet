# Copier en .env et adapter. Ne jamais versionner le vrai fichier.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=lesgrandsvoisins.com,www.lesgrandsvoisins.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lesgrandsvoisins.com,https://www.lesgrandsvoisins.com

DJANGO_IP=127.0.0.1
DJANGO_PORT=8000

# Base de données : SQLite par défaut (un seul fichier, var/db.sqlite3), suffisant à
# cette échelle. Définir POSTGRES_DB pour passer à PostgreSQL (installer aussi
# psycopg, présent dans requirements.txt).
#POSTGRES_DB=lesgrandsvoisins
#POSTGRES_USER=lesgrandsvoisins
#POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long-et-aleatoire
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

DEFAULT_LANG="fr"
LANGUAGES="fr, en, es, ar, ko"
FALLBACK_LANGUAGES="fr"

# Empreinte des numéros anonymes : à fixer une fois pour toutes, puis ne plus jamais changer.
VOISINTERNET_ANON_PEPPER=remplacer-par-une-autre-longue-chaine-aleatoire
VOISINTERNET_BEHIND_PROXY=true
VOISINTERNET_CONTACT_EMAIL=contact@lesgrandsvoisins.com

# E-mail sortant (formulaire « Contacter l'auteur·ice ») : laisser EMAIL_HOST vide
# pour désactiver l'envoi réel (les messages s'affichent dans les logs à la place).
#EMAIL_HOST=smtp.example.org
#EMAIL_PORT=587
#EMAIL_HOST_USER=lesgrandsvoisins
#EMAIL_HOST_PASSWORD=remplacer-par-un-mot-de-passe-long-et-aleatoire
#EMAIL_USE_TLS=true
#DEFAULT_FROM_EMAIL=contact@lesgrandsvoisins.com

# Keycloak : laisser vide pour désactiver la connexion nominative.
KEYCLOAK_REALM_URL=https://auth.example.org/realms/grands-voisins
OIDC_RP_CLIENT_ID=voisinternet
OIDC_RP_CLIENT_SECRET=

# Ghost : clé de l'API de contenu (lecture seule), pour les derniers articles.
VOISINTERNET_BLOG_URL=https://blog.lesgrandsvoisins.com
GHOST_CONTENT_KEY=

# Wiki (Wiki.js) : GUIDE_URL sert de lien direct et de base pour sa recherche en
# GraphQL (core/wikijs.py) — laisser WIKIJS_API_KEY vide désactive cette dernière,
# le lien direct reste actif.
VOISINTERNET_GUIDE_URL=https://wiki.grandsvoisins.org
WIKIJS_API_KEY=
