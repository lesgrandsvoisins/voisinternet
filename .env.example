# Copier en .env et adapter. Ne jamais versionner le vrai fichier.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=voisinter.net,www.voisinter.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://voisinter.net,https://www.voisinter.net

DJANGO_IP=127.0.0.1
DJANGO_PORT=8000

# Base de données : SQLite par défaut (un seul fichier, var/db.sqlite3), suffisant à
# cette échelle. Définir POSTGRES_DB pour passer à PostgreSQL (installer aussi
# psycopg, présent dans requirements.txt).
#POSTGRES_DB=voisinternet
#POSTGRES_USER=voisinternet
#POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long-et-aleatoire
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

DEFAULT_LANG="fr"
LANGUAGES="fr, en, es, ar, ko"
FALLBACK_LANGUAGES="fr"

# Empreinte des numéros anonymes : à fixer une fois pour toutes, puis ne plus jamais changer.
VOISINTERNET_ANON_PEPPER=remplacer-par-une-autre-longue-chaine-aleatoire
VOISINTERNET_BEHIND_PROXY=true
VOISINTERNET_CONTACT_EMAIL=contact@voisinter.net

# Keycloak : laisser vide pour désactiver la connexion nominative.
KEYCLOAK_REALM_URL=https://auth.example.org/realms/grands-voisins
OIDC_RP_CLIENT_ID=voisinternet
OIDC_RP_CLIENT_SECRET=

# Ghost : clé de l'API de contenu (lecture seule), pour les derniers articles.
VOISINTERNET_BLOG_URL=https://voix.voisinter.net
GHOST_CONTENT_KEY=

# BookStack
VOISINTERNET_GUIDE_URL=https://voies.voisinter.net
