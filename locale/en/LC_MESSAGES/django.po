msgid "Partenariat Voisinternet"
msgstr "Voisinternet partnership"

#: core/templates/core/vous_voyez.html:23
msgid "Proposer un partenariat"
msgstr "Propose a partnership"

#: core/templates/core/vous_voyez.html:29
msgid "Voir les services proposés aux habitants"
msgstr "See the services offered to residents"

