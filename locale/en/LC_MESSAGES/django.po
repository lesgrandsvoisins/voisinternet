msgstr "Board composition"

#: core/templates/core/nous_voyons.html:11
msgid "Comptes annuels"
msgstr "Annual accounts"

#: core/templates/core/nous_voyons.html:12
msgid "Comptes rendus d'assemblée générale"
msgstr "General assembly minutes"

#: core/templates/core/nous_voyons.html:13
