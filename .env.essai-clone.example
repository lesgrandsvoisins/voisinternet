# Essai LOCAL de voisinternet contre le clone de Keycloak (key.resdigita.org), sur le poste de Chris.
# Copier en `.env` (ou lancer avec un autre fichier), puis remplir les trois valeurs marquées « À REMPLIR ».
# AUCUN secret de production dans ce fichier du dépôt ; le secret du client se copie à la main depuis l'environnement de production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=essai-local-ne-pas-reutiliser-en-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_IP=127.0.0.1
DJANGO_PORT=8000
# Autre pepper que la production (jamais le vrai) ; base jetable, donc sans conséquence.
VOISINTERNET_ANON_PEPPER=essai-local-pepper-jetable
VOISINTERNET_BEHIND_PROXY=false
# Pas de courrier réel, pas d'écriture dans l'annuaire par les redirections de courrier.
EMAIL_HOST=
VOISINTERNET_REDIRECTIONS=non
# PostgreSQL jetable (le contrat SQL des demandes — migrations 0039 à 0042 — est PostgreSQL) :
#   docker run --rm --name essai-pg -e POSTGRES_PASSWORD=essai -e POSTGRES_DB=essai -p 5433:5432 postgres:17
POSTGRES_DB=essai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=essai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Le clone de Keycloak (jamais key.gv.je ni la production pour cet essai).
KEYCLOAK_REALM_URL=https://key.resdigita.org/realms/master
OIDC_RP_CLIENT_ID=voisinternet
# À REMPLIR : secret du client `voisinternet` (le même que sur key.gv.je), copié depuis l'environnement de production.
OIDC_RP_CLIENT_SECRET=
